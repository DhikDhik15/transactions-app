PORT=3000

# For Neon/Production (uncomment and use)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# For Local Development with PostgreSQL (uncomment and use if not using DATABASE_URL)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=transactions_app
# DB_USER=postgres
# DB_PASSWORD=your_password

DB_TIMEZONE=+07:00
DB_LOGGING=false

# Migrations are preferred. Set DB_SYNC=true only for quick prototyping without migrations.
DB_SYNC=false
DB_ALTER=false
SEED_SERVICES=true

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
