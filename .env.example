PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=transactions_app
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+07:00
DB_LOGGING=false

# Set DB_CREATE=false if the database is created and managed manually.
DB_CREATE=true
# Migrations are preferred. Set DB_SYNC=true only for quick prototyping without migrations.
DB_SYNC=false
DB_ALTER=false
SEED_SERVICES=true

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
